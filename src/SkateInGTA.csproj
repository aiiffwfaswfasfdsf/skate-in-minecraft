<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- C# 5 keeps the source compatible with ScriptHookVDotNet's built-in .cs compiler. -->
    <LangVersion>5</LangVersion>
    <AssemblyName>SkateInGTA</AssemblyName>
    <RootNamespace>SkateInGTA</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.8.0</Version>
    <Product>Skate in GTA</Product>
    <Description>Skate-style skateboarding for GTA V Story Mode.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the API only; the game loads its own ScriptHookVDotNet3.dll at runtime. -->
    <PackageReference Include="ScriptHookVDotNet3" Version="3.6.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
